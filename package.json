{
  "name": "dsh-gateway",
  "version": "0.1.0",
  "description": "Private, zero-trust gateway for DeepSeek Harness Web: loopback-only proxy, exact principal allowlists, and provider-agnostic onboarding",
  "license": "MIT",
  "author": "TiantianFlow",
  "type": "module",
  "main": "src/plugin.mjs",
  "exports": "./src/plugin.mjs",
  "bin": {
    "dsh-gateway": "./bin/dsh-gateway.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/sidecar.mjs",
    "test": "node --test --test-concurrency=1",
    "check": "node --check src/plugin.mjs && node --check src/sidecar.mjs && node --check src/core/server.mjs && node --check src/core/config.mjs && node --check bin/dsh-gateway.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "jose": "^5.10.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "gateway",
    "zero-trust",
    "tailscale",
    "cloudflare-access",
    "reverse-proxy",
    "websocket",
    "remote-access",
    "security"
  ]
}
